# Copy this file to .env, then enter your key privately on this computer.
# Never paste a real key in chat or commit .env to Git.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_TIMEOUT=300

